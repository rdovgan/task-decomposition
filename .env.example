# Example Environment Configuration
# Copy this file to .env and update with your values

# Environment
NODE_ENV=development

# Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://taskdecomp:taskdecomp@localhost:5432/task_decomposition?schema=public"

# API Configuration
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Z.AI Coding Plan API (OpenAI-compatible)
# Get your API key from: https://z.ai/
ZAI_API_KEY="your-zai-api-key-here"
ZAI_BASE_URL="https://api.z.ai/api/coding/paas/v4"
ZAI_MODEL="glm-5-turbo"
API_TIMEOUT_MS="3000000"

# JWT Secret (for future authentication)
# IMPORTANT: Use a strong, unique secret in production!
JWT_SECRET="your-secret-key-change-in-production"

# Public Decompose API (POST /api/v1/decompose)
# Required for external/programmatic clients: sent as the X-API-Key header.
# Leave unset to keep the public API disabled (returns 503).
DECOMPOSE_API_KEY="your-public-api-key-here"

# Feature Flags
ENABLE_AI_DECOMPOSITION=true
ENABLE_TASK_GRAPH=true
ENABLE_COMMENTS=true

# Environment-Specific Notes:
#
# Development:
# - Database: task_decomposition_dev
# - Port: 3000 (frontend), 3001 (backend)
# - Hot reload enabled
#
# Staging:
# - Database: task_decomposition_staging
# - Used for pre-production testing
# - Mimics production configuration
#
# Production:
# - Database: task_decomposition_prod
# - Requires strong JWT_SECRET
# - Use production API keys
# - Enable monitoring and logging
#
# Test:
# - Database: task_decomposition_test
# - Use test API keys or mocks
# - Automated testing environment
