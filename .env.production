# Production Environment Configuration
NODE_ENV=production

# Database - Production
DATABASE_URL="postgresql://taskdecomp:CHANGE_ME@localhost:5432/task_decomposition_prod?schema=public"

# API
PORT=3001
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# CORS
ALLOWED_ORIGINS="https://yourdomain.com,https://api.yourdomain.com"

# Anthropic API (for AI task decomposition)
ANTHROPIC_API_KEY="your-production-anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# JWT Secret (for future authentication)
JWT_SECRET="CHANGE_ME_USE_STRONG_PASSWORD"

# Feature Flags
ENABLE_AI_DECOMPOSITION=true
ENABLE_TASK_GRAPH=true
ENABLE_COMMENTS=true
