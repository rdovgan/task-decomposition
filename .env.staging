# Staging Environment Configuration
NODE_ENV=staging

# Database - Staging
DATABASE_URL="postgresql://taskdecomp:taskdecomp@localhost:5432/task_decomposition_staging?schema=public"

# API
PORT=3001
NEXT_PUBLIC_API_URL=https://staging-api.yourdomain.com/api

# CORS
ALLOWED_ORIGINS="https://staging.yourdomain.com,https://staging-api.yourdomain.com"

# Anthropic API (for AI task decomposition)
ANTHROPIC_API_KEY="your-staging-anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# JWT Secret (for future authentication)
JWT_SECRET="staging-secret-key-change-in-production"

# Feature Flags
ENABLE_AI_DECOMPOSITION=true
ENABLE_TASK_GRAPH=true
ENABLE_COMMENTS=true
