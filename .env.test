# Test Environment Configuration
NODE_ENV=test

# Database - Test (in-memory or separate test DB)
DATABASE_URL="postgresql://taskdecomp:taskdecomp@localhost:5432/task_decomposition_test?schema=public"

# API
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# CORS
ALLOWED_ORIGINS="http://localhost:3000"

# Anthropic API (use mock for tests)
ANTHROPIC_API_KEY="test-key"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# JWT Secret
JWT_SECRET="test-secret-key"

# Feature Flags
ENABLE_AI_DECOMPOSITION=true
ENABLE_TASK_GRAPH=true
ENABLE_COMMENTS=true
