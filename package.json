{
  "name": "task-decomposition-tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "next build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "next start",
    "start:server": "node dist/server/index.js",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "docker:ps": "docker compose ps",
    "docker:shell:app": "docker compose exec app sh",
    "docker:shell:server": "docker compose exec server sh",
    "docker:shell:db": "docker compose exec postgres psql -U taskdecomp -d task_decomposition",
    "docker:db:push": "docker compose exec server npx prisma db push",
    "docker:db:migrate": "docker compose exec server npx prisma migrate deploy",
    "docker:db:seed": "docker compose exec server npx tsx prisma/seed.ts",
    "docker:db:studio": "docker compose --profile tools up -d studio",
    "docker:staging:up": "docker compose -f docker-compose.staging.yml up -d",
    "docker:staging:down": "docker compose -f docker-compose.staging.yml down",
    "docker:prod:up": "docker compose -f docker-compose.production.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.production.yml down",
    "docker:clean": "docker compose down -v --rmi local",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "npm run db:migrate:reset && npm run db:seed",
    "test": "npx jest",
    "test:watch": "npx jest --watch",
    "test:coverage": "npx jest --coverage",
    "test:server": "npx jest --config jest.server.config.js",
    "test:server:watch": "npx jest --config jest.server.config.js --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "env:dev": "./scripts/switch-env.sh development",
    "env:staging": "./scripts/switch-env.sh staging",
    "env:prod": "./scripts/switch-env.sh production",
    "env:test": "./scripts/switch-env.sh test",
    "env:current": "echo \"Current environment: ${NODE_ENV:-development}\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.81.0",
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@types/multer": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.7.0",
    "multer": "^2.1.1",
    "next": "16.2.2",
    "openai": "^6.38.0",
    "pdfjs-dist": "^5.4.296",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "reactflow": "^11.11.4",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/environment": "^30.3.0",
    "@playwright/test": "^1.59.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "file:testing-library-react-16.3.2.tgz",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "canvas": "^3.2.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "prisma": "^7.6.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
