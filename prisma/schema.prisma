// Task Decomposition Tool - Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User model for authentication and team members
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      UserRole @default(DEVELOPER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ownedProjects Project[]      @relation("ProjectOwner")
  assignedTasks Task[]         @relation("TaskAssignee")
  comments      Comment[]
  settings      UserSettings?

  @@map("users")
}

// User settings for storing preferences and API keys
model UserSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  anthropicApiKey String?  // Encrypted API key for Anthropic/Claude
  jiraSiteUrl     String?  // e.g. https://your-domain.atlassian.net
  jiraEmail       String?
  jiraApiToken    String?  // Encrypted Jira Cloud API token
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
  DESIGNER
  QA
}

// Project model - top level container
model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  ownerId     String
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  owner   User         @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  epics   Epic[]

  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  ON_HOLD
}

// Epic model - large feature/user story
model Epic {
  id          String     @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      EpicStatus @default(BACKLOG)
  priority    Priority   @default(MEDIUM)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@map("epics")
}

enum EpicStatus {
  BACKLOG
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

// Task model - individual work item
model Task {
  id             String        @id @default(cuid())
  epicId         String
  title          String
  description    String?
  assigneeId     String?
  status         TaskStatus    @default(TODO)
  priority       Priority      @default(MEDIUM)
  storyPoints    Int?
  estimatedHours Float?
  actualHours    Float?
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  epic          Epic          @relation(fields: [epicId], references: [id], onDelete: Cascade)
  assignee      User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dependencies  Dependency[]  @relation("TaskDependencies")
  dependents    Dependency[]  @relation("DependentTasks")
  links         TaskLink[]
  comments      Comment[]

  @@index([epicId])
  @@index([assigneeId])
  @@index([status])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
  CANCELLED
}

// Dependency model - task dependencies
model Dependency {
  id               String         @id @default(cuid())
  taskId           String
  dependsOnTaskId  String
  type             DependencyType @default(BLOCKS)
  createdAt        DateTime       @default(now())

  // Relations
  task         Task @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn    Task @relation("DependentTasks", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
  @@map("dependencies")
}

enum DependencyType {
  BLOCKS        // Task A blocks Task B
  RELATED_TO    // Tasks are related but don't block
  DUPLICATES    // Tasks are duplicates
}

// TaskLink model - external documentation links
model TaskLink {
  id        String   @id @default(cuid())
  taskId    String
  url       String
  linkType  LinkType
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_links")
}

enum LinkType {
  CONFLUENCE
  NOTION
  GITHUB
  JIRA
  FIGMA
  EXTERNAL
}

// Team configuration - reusable team presets for estimation
model TeamConfig {
  id          String   @id @default(cuid())
  name        String
  description String?
  config      Json     // { members: [{ role: "senior", specialty: "java" }, ...] }
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("team_configs")
}

// Comment model - task discussions
model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
  @@map("comments")
}
